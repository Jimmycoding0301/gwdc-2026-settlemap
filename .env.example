# GasFree Nile server credentials. Fixture mode needs no credentials.
# Keep API secrets on the local server; never expose them through VITE_ variables.
GASFREE_API_KEY=
GASFREE_API_SECRET=
GASFREE_BASE_URL=https://open-test.gasfree.io/nile
GASFREE_TRON_RPC_URL=https://nile.trongrid.io
TRONGRID_API_KEY=

# Explicit kill switch. Only true permits /gasfree/submit after a TronLink TIP-712
# signature. Read-only preflight still requires the GasFree API credentials above.
ENABLE_GASFREE_LIVE=false

# Never add a wallet private key or seed phrase here. Live wallet signing is
# performed by TronLink in the browser; the backend never requests a private key.
