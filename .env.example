# GasFree Nile server credentials. Fixture mode needs no credentials.
# Keep API secrets on the local server; never expose them through VITE_ variables.
GASFREE_API_KEY=
GASFREE_API_SECRET=
GASFREE_BASE_URL=https://open-test.gasfree.io/nile
GASFREE_TRON_RPC_URL=https://nile.trongrid.io
TRONGRID_API_KEY=

# Explicit kill switch. Only true permits /gasfree/submit after a TronLink TIP-712
# signature. Read-only preflight still requires the GasFree API credentials above.
ENABLE_GASFREE_LIVE=false

# Browser live mode signs with TronLink. The optional one-shot CLI reads a
# dedicated 0600 private-key file under ignored .data; never put the key itself
# or a seed phrase in this env file.
GASFREE_SIGNER_KEY_FILE=.data/gasfree-nile-signer.key

# Optional one-shot CLI defaults. Amount is integer micro-USDT. Keep broadcast
# authorization on the command line so an old env file cannot enable a write.
GASFREE_PAYER_ADDRESS=
GASFREE_RECEIVER_ADDRESS=
GASFREE_AMOUNT_MICROS=
GASFREE_INTENT_ID=
GASFREE_PROVIDER_ADDRESS=
GASFREE_TOKEN_ADDRESS=
GASFREE_POLL_SECONDS=120
